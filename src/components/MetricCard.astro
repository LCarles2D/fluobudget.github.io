---
interface Props {
  id: string;
  title: string;
  defaultValue: string;
  lucideIcon?: string;
  emojiIcon?: string;
}

const { id, title, defaultValue, lucideIcon, emojiIcon } = Astro.props;
---

<div class="metric-card-inner">
  <div class="metric-header">
    <span class="metric-icon">
      {lucideIcon ? <i data-lucide={lucideIcon}></i> : emojiIcon || "📊"}
    </span>
    <span class="metric-title">{title}</span>
  </div>
  <div class="metric-value" id={id}>{defaultValue}</div>
</div>
