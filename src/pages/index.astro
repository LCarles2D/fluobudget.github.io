---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MetricCard from "../components/MetricCard.astro";
import RecommendationBox from "../components/RecommendationBox.astro";
import QuickRegister from "../components/QuickRegister.astro";
import TodayExpenses from "../components/TodayExpenses.astro";
import WeeklyHistory from "../components/WeeklyHistory.astro";
import AnalyticsTab from "../components/AnalyticsTab.astro";
import BottomNav from "../components/BottomNav.astro";
import ProductsModal from "../components/ProductsModal.astro";
import Toast from "../components/Toast.astro";
---

<Layout
  title="Fluo Budget — Control Presupuesto Semanal"
  description="Control de presupuesto semanal fácil y visual, registro rápido de gastos y análisis amigable."
>
  <!-- HEADER -->
  <Header budgetFormatted="$30.00" />

  <main>
    <!-- ================= PESTAÑA 1: REGISTRO (INICIO) ================= -->
    <section id="tabRegister" class="tab-view" aria-labelledby="registerTitle">
      <h2 id="registerTitle" class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Panel de Registro</h2>

      <!-- RESUMEN DE LA SEMANA -->
      <div class="card metrics-card" aria-labelledby="metricsTitle">
        <h2 id="metricsTitle" class="section-title">
          <span class="title-icon"><i data-lucide="bar-chart-3"></i></span> Resumen de la Semana
        </h2>
        <div class="metric-grid">
          <MetricCard id="acValue" title="Total Gastado" defaultValue="$0.00" lucideIcon="dollar-sign" />
          <MetricCard id="remainingValue" title="Disponible" defaultValue="$30.00" lucideIcon="piggy-bank" />
          <MetricCard id="cvValue" title="Balance / Ahorro" defaultValue="$0.00" lucideIcon="trending-down" />
          <MetricCard id="cpiValue" title="Rendimiento" defaultValue="1.00" lucideIcon="zap" />
        </div>
        <RecommendationBox />
      </div>

      <!-- REGISTRO RÁPIDO ONE-TAP -->
      <QuickRegister />

      <!-- GASTOS DE HOY -->
      <TodayExpenses />
    </section>

    <!-- ================= PESTAÑA 2: HISTORIAL EXTENDIDO ================= -->
    <WeeklyHistory />

    <!-- ================= PESTAÑA 3: ANÁLISIS EVM Y GRÁFICAS ================= -->
    <AnalyticsTab />
  </main>

  <!-- BARRA DE NAVEGACIÓN INFERIOR (BOTTOM NAV) -->
  <BottomNav />

  <!-- MODAL: ADMINISTRAR PRODUCTOS -->
  <ProductsModal />

  <!-- TOAST FEEDBACK -->
  <Toast />

  <!-- SCRIPT CLIENTE -->
  <script src="../scripts/app.js"></script>
</Layout>
