---
import MetricCard from "../components/MetricCard.astro";
import RecommendationBox from "../components/RecommendationBox.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="description" content="Control de presupuesto semanal con métricas EVM. Registra gastos rápidamente y mantén tu presupuesto de $30 bajo control." />
    <title>BudgetFlow — Control Presupuesto $30</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>

    <!-- HEADER -->
    <header class="app-header">
      <div class="header-left">
        <div class="app-logo">💰</div>
        <div>
          <h1 class="app-title">BudgetFlow</h1>
          <p class="app-subtitle">Semana · $30.00 BAC</p>
        </div>
      </div>
      <button id="openProductsBtn" class="icon-btn" aria-label="Administrar Productos" title="Administrar Productos">
        ⚙️
      </button>
    </header>

    <main>

      <!-- MÉTRICAS EVM -->
      <section class="card metrics-card" aria-labelledby="metricsTitle">
        <h2 id="metricsTitle" class="section-title">
          <span class="title-icon">📊</span> Métricas EVM
        </h2>
        <div class="metric-grid">
          <MetricCard id="acValue"        title="Gasto Real (AC)"    defaultValue="$0.00"  icon="💸" />
          <MetricCard id="remainingValue" title="Restante"           defaultValue="$30.00" icon="🏦" />
          <MetricCard id="cvValue"        title="Cost Variance (CV)" defaultValue="$0.00"  icon="📉" />
          <MetricCard id="cpiValue"       title="Índice CPI"         defaultValue="1.00"   icon="⚡" />
        </div>
        <RecommendationBox />
      </section>

      <!-- REGISTRO RÁPIDO ONE-TAP -->
      <section class="card" id="quickRegisterSection" aria-labelledby="quickTitle">
        <div class="section-header">
          <h2 id="quickTitle" class="section-title">
            <span class="title-icon">⚡</span> Registro Rápido
          </h2>
          <span class="badge" id="productCount">0 productos</span>
        </div>

        <div id="productGrid" class="product-grid" role="list" aria-label="Productos disponibles">
        </div>

        <!-- Panel de confirmación -->
        <div id="confirmPanel" class="confirm-panel hidden" role="dialog" aria-label="Confirmar gasto">
          <div class="confirm-header">
            <span id="confirmProductIcon" class="confirm-icon">🛒</span>
            <div>
              <p class="confirm-label" id="confirmProductName">Producto</p>
              <p class="confirm-base-price" id="confirmBasePrice">Precio base: $0.00</p>
            </div>
          </div>
          <div class="confirm-amount-row">
            <label for="confirmAmount" class="confirm-amount-label">Monto real ($):</label>
            <input
              type="number"
              id="confirmAmount"
              class="confirm-amount-input"
              step="0.01"
              min="0"
              placeholder="0.00"
              inputmode="decimal"
              aria-label="Monto real del gasto"
            />
          </div>
          <div class="confirm-actions">
            <button id="cancelConfirmBtn" class="btn btn-ghost">✕ Cancelar</button>
            <button id="addExpenseBtn"    class="btn btn-primary">✓ Registrar</button>
          </div>
        </div>
      </section>

      <!-- HISTORIAL DE TRANSACCIONES -->
      <section class="card" aria-labelledby="historyTitle">
        <div class="section-header">
          <h2 id="historyTitle" class="section-title">
            <span class="title-icon">📋</span> Historial
          </h2>
          <button id="resetBtn" class="btn btn-danger-ghost btn-sm" aria-label="Reiniciar semana">
            🔄 Reset
          </button>
        </div>
        <div id="expenseLog" class="expense-log" aria-live="polite">
          <p class="empty-state">Sin gastos registrados esta semana.</p>
        </div>
      </section>

    </main>

    <!-- MODAL: ADMINISTRAR PRODUCTOS -->
    <div id="productsModal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-container">
        <div class="modal-header">
          <h2 id="modalTitle" class="modal-title">⚙️ Administrar Productos</h2>
          <button id="closeProductsBtn" class="icon-btn" aria-label="Cerrar modal">✕</button>
        </div>

        <div class="product-form card-inner" id="productFormWrapper">
          <h3 class="form-subtitle" id="productFormTitle">➕ Nuevo Producto</h3>
          <div class="form-row">
            <input type="text"   id="pName"  class="form-input" placeholder="Nombre del producto" maxlength="30" aria-label="Nombre del producto" />
            <input type="number" id="pPrice" class="form-input form-input--sm" step="0.01" min="0" placeholder="$ Precio" inputmode="decimal" aria-label="Precio base" />
          </div>
          <div class="form-row">
            <input type="text" id="pIcon" class="form-input form-input--icon" placeholder="Emoji" maxlength="4" aria-label="Emoji del producto" />
            <div class="form-actions">
              <button id="cancelEditBtn" class="btn btn-ghost btn-sm hidden">Cancelar</button>
              <button id="saveProductBtn" class="btn btn-primary btn-sm">Guardar</button>
            </div>
          </div>
        </div>

        <div id="adminProductList" class="admin-list" role="list" aria-label="Lista de productos">
        </div>
      </div>
    </div>

    <!-- TOAST -->
    <div id="toast" class="toast hidden" role="alert" aria-live="assertive"></div>

    <script>
      const BUDGET      = 30.0;
      const CAFE_UNIT   = 0.35;
      const STORAGE_PRODUCTS = 'custom_products_30';
      const STORAGE_EXPENSES = 'astro_expenses_30';

      const DEFAULT_PRODUCTS = [
        { id: 'p1', name: 'Pasaje Ida',        price: 2.15, icon: '🚌' },
        { id: 'p2', name: 'Pasaje Vuelta',      price: 1.90, icon: '🚌' },
        { id: 'p3', name: 'Cenas con Amigos',   price: 1.70, icon: '🍽️' },
        { id: 'p4', name: 'Café Tarde',         price: 0.35, icon: '☕' },
        { id: 'p5', name: 'Almuerzo Lunes',     price: 2.00, icon: '🥗' },
        { id: 'p6', name: 'Súper Mercado',      price: 8.50, icon: '🛒' },
        { id: 'p7', name: 'Salida Novia',       price: 5.00, icon: '💑' },
      ];

      let products   = loadProducts();
      let expenses   = loadExpenses();
      let selectedProduct = null;
      let editingId  = null;

      function loadProducts() {
        try { const s = localStorage.getItem(STORAGE_PRODUCTS); return s ? JSON.parse(s) : JSON.parse(JSON.stringify(DEFAULT_PRODUCTS)); }
        catch { return JSON.parse(JSON.stringify(DEFAULT_PRODUCTS)); }
      }
      function saveProducts() { localStorage.setItem(STORAGE_PRODUCTS, JSON.stringify(products)); }
      function loadExpenses() {
        try { const s = localStorage.getItem(STORAGE_EXPENSES); return s ? JSON.parse(s) : []; }
        catch { return []; }
      }
      function saveExpenses() { localStorage.setItem(STORAGE_EXPENSES, JSON.stringify(expenses)); }
      function genId() { return Date.now() + '-' + Math.random().toString(36).slice(2, 7); }

      // Toast
      function showToast(msg, type = 'success') {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.className = 'toast toast--' + type;
        setTimeout(() => { toast.className = 'toast hidden'; }, 2800);
      }

      // Dashboard EVM
      function updateDashboard() {
        let totalAC = 0, totalEV = 0;
        expenses.forEach(item => { totalAC += item.amount; totalEV += item.basePrice; });

        const remaining = BUDGET - totalAC;
        const cv  = totalEV - totalAC;
        const cpi = totalAC > 0 ? totalEV / totalAC : 1.0;

        setMetric('acValue',        '$' + totalAC.toFixed(2));
        setMetric('remainingValue', '$' + remaining.toFixed(2), remaining < 5 ? 'negative' : remaining < 10 ? 'warn' : 'positive');
        setMetric('cvValue',  '$' + cv.toFixed(2),  cv < 0 ? 'negative' : cv > 0 ? 'positive' : '');
        setMetric('cpiValue', cpi.toFixed(2),        cpi < 1 ? 'negative' : 'positive');

        const recBox  = document.getElementById('recommendationBox');
        const recIcon = recBox.querySelector('.rec-icon');
        const recText = recBox.querySelector('.rec-text');

        if (cv < 0) {
          const deficit    = Math.abs(cv).toFixed(2);
          const cafesToCut = Math.ceil(Math.abs(cv) / CAFE_UNIT);
          recIcon.textContent = '⚠️';
          recText.innerHTML = '<strong>Desviación Negativa (-$' + deficit + '):</strong> Sobrecosto detectado.<br>👉 <em>Acción Correctiva:</em> Recorta <strong>' + cafesToCut + ' café(s) ☕</strong> para reequilibrar la línea base.';
          recBox.style.borderLeftColor = '#ef4444';
        } else if (cv > 0) {
          recIcon.textContent = '✅';
          recText.innerHTML = '<strong>Ahorro detectado (+$' + cv.toFixed(2) + '):</strong> Gastos por debajo del costo planificado. ¡Bien hecho!';
          recBox.style.borderLeftColor = '#22c55e';
        } else {
          recIcon.textContent = '👍';
          recText.innerHTML = '<strong>Línea Base Correcta:</strong> Gastos perfectamente alineados al plan.';
          recBox.style.borderLeftColor = '#3b82f6';
        }

        renderExpenseLog();
        saveExpenses();
      }

      function setMetric(id, value, className) {
        const el = document.getElementById(id);
        el.textContent = value;
        el.className = 'metric-value' + (className ? ' ' + className : '');
      }

      // Product Grid
      function renderProductGrid() {
        const grid  = document.getElementById('productGrid');
        const badge = document.getElementById('productCount');
        badge.textContent = products.length + ' producto' + (products.length !== 1 ? 's' : '');

        grid.innerHTML = products.map(p =>
          '<button class="product-card" data-id="' + p.id + '" role="listitem" aria-label="Registrar ' + p.name + ' por $' + p.price.toFixed(2) + '">' +
            '<span class="pc-icon">' + (p.icon || '🏷️') + '</span>' +
            '<span class="pc-name">' + p.name + '</span>' +
            '<span class="pc-price">$' + p.price.toFixed(2) + '</span>' +
          '</button>'
        ).join('');

        grid.querySelectorAll('.product-card').forEach(btn => {
          btn.addEventListener('click', () => {
            const product = products.find(p => p.id === btn.dataset.id);
            if (product) openConfirmPanel(product);
          });
        });
      }

      // Confirm Panel
      function openConfirmPanel(product) {
        selectedProduct = product;
        document.getElementById('confirmProductIcon').textContent = product.icon || '🏷️';
        document.getElementById('confirmProductName').textContent = product.name;
        document.getElementById('confirmBasePrice').textContent   = 'Precio base: $' + product.price.toFixed(2);

        const amountInput = document.getElementById('confirmAmount');
        amountInput.value = product.price.toFixed(2);

        const panel = document.getElementById('confirmPanel');
        panel.classList.remove('hidden');
        amountInput.focus();
        amountInput.select();

        document.querySelectorAll('.product-card').forEach(c => c.classList.remove('selected'));
        const selCard = document.querySelector('.product-card[data-id="' + product.id + '"]');
        if (selCard) selCard.classList.add('selected');
      }

      function closeConfirmPanel() {
        document.getElementById('confirmPanel').classList.add('hidden');
        selectedProduct = null;
        document.querySelectorAll('.product-card').forEach(c => c.classList.remove('selected'));
      }

      document.getElementById('cancelConfirmBtn').addEventListener('click', closeConfirmPanel);

      document.getElementById('addExpenseBtn').addEventListener('click', () => {
        if (!selectedProduct) return;
        const amountInput = document.getElementById('confirmAmount');
        const amount = parseFloat(amountInput.value);
        if (isNaN(amount) || amount <= 0) {
          showToast('Ingresa un monto válido mayor a $0', 'error');
          amountInput.focus();
          return;
        }
        expenses.push({
          id:          genId(),
          productId:   selectedProduct.id,
          productName: selectedProduct.name,
          productIcon: selectedProduct.icon,
          basePrice:   selectedProduct.price,
          amount:      amount,
          date:        new Date().toISOString(),
        });
        closeConfirmPanel();
        updateDashboard();
        showToast('✅ Registrado: ' + selectedProduct.name + ' · $' + amount.toFixed(2));
      });

      document.getElementById('confirmAmount').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('addExpenseBtn').click();
      });

      // Expense Log
      function renderExpenseLog() {
        const log = document.getElementById('expenseLog');
        if (expenses.length === 0) {
          log.innerHTML = '<p class="empty-state">Sin gastos registrados esta semana.</p>';
          return;
        }
        log.innerHTML = expenses.slice().reverse().map(item => {
          const dt   = new Date(item.date);
          const time = dt.toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
          const day  = dt.toLocaleDateString('es', { weekday: 'short', day: 'numeric' });
          const diff = item.amount - item.basePrice;
          const diffStr = diff !== 0
            ? '<span class="diff ' + (diff > 0 ? 'diff--over' : 'diff--under') + '">' + (diff > 0 ? '+' : '') + '$' + diff.toFixed(2) + '</span>'
            : '';
          return '<div class="log-item" data-id="' + item.id + '">' +
            '<span class="log-icon">' + (item.productIcon || '🏷️') + '</span>' +
            '<div class="log-info">' +
              '<span class="log-name">' + item.productName + diffStr + '</span>' +
              '<span class="log-date">' + day + ' · ' + time + '</span>' +
            '</div>' +
            '<span class="log-amount">$' + item.amount.toFixed(2) + '</span>' +
            '<button class="delete-expense-btn" data-id="' + item.id + '" aria-label="Eliminar gasto ' + item.productName + '">🗑️</button>' +
          '</div>';
        }).join('');

        log.querySelectorAll('.delete-expense-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            expenses = expenses.filter(e => e.id !== btn.dataset.id);
            updateDashboard();
            showToast('Gasto eliminado', 'info');
          });
        });
      }

      document.getElementById('resetBtn').addEventListener('click', () => {
        if (confirm('¿Reiniciar el presupuesto semanal? Se borrarán todos los gastos.')) {
          expenses = [];
          updateDashboard();
          showToast('Semana reiniciada 🔄', 'info');
        }
      });

      // Modal Productos
      function openProductsModal() {
        document.getElementById('productsModal').classList.remove('hidden');
        renderAdminList();
        resetProductForm();
      }
      function closeProductsModal() {
        document.getElementById('productsModal').classList.add('hidden');
        editingId = null;
      }

      document.getElementById('openProductsBtn').addEventListener('click', openProductsModal);
      document.getElementById('closeProductsBtn').addEventListener('click', closeProductsModal);
      document.getElementById('productsModal').addEventListener('click', (e) => {
        if (e.target.id === 'productsModal') closeProductsModal();
      });

      function resetProductForm() {
        editingId = null;
        document.getElementById('pName').value  = '';
        document.getElementById('pPrice').value = '';
        document.getElementById('pIcon').value  = '';
        document.getElementById('productFormTitle').textContent = '➕ Nuevo Producto';
        document.getElementById('saveProductBtn').textContent   = 'Guardar';
        document.getElementById('cancelEditBtn').classList.add('hidden');
      }

      function renderAdminList() {
        const list = document.getElementById('adminProductList');
        if (products.length === 0) {
          list.innerHTML = '<p class="empty-state" style="padding:16px">No hay productos. Agrega uno arriba.</p>';
          return;
        }
        list.innerHTML = products.map(p =>
          '<div class="admin-item" role="listitem">' +
            '<span class="admin-icon">' + (p.icon || '🏷️') + '</span>' +
            '<div class="admin-info">' +
              '<span class="admin-name">' + p.name + '</span>' +
              '<span class="admin-price">$' + p.price.toFixed(2) + '</span>' +
            '</div>' +
            '<div class="admin-actions">' +
              '<button class="icon-btn edit-product-btn" data-id="' + p.id + '" aria-label="Editar ' + p.name + '">✏️</button>' +
              '<button class="icon-btn delete-product-btn" data-id="' + p.id + '" aria-label="Eliminar ' + p.name + '">🗑️</button>' +
            '</div>' +
          '</div>'
        ).join('');

        list.querySelectorAll('.edit-product-btn').forEach(btn => {
          btn.addEventListener('click', () => startEditProduct(btn.dataset.id));
        });
        list.querySelectorAll('.delete-product-btn').forEach(btn => {
          btn.addEventListener('click', () => deleteProduct(btn.dataset.id));
        });
      }

      function startEditProduct(id) {
        const product = products.find(p => p.id === id);
        if (!product) return;
        editingId = id;
        document.getElementById('pName').value  = product.name;
        document.getElementById('pPrice').value = product.price.toFixed(2);
        document.getElementById('pIcon').value  = product.icon || '';
        document.getElementById('productFormTitle').textContent = '✏️ Editar Producto';
        document.getElementById('saveProductBtn').textContent   = 'Actualizar';
        document.getElementById('cancelEditBtn').classList.remove('hidden');
        document.getElementById('pName').focus();
        document.getElementById('productFormWrapper').scrollIntoView({ behavior: 'smooth' });
      }

      function deleteProduct(id) {
        const product = products.find(p => p.id === id);
        if (!product) return;
        if (confirm('¿Eliminar "' + product.name + '"?')) {
          products = products.filter(p => p.id !== id);
          saveProducts();
          renderAdminList();
          renderProductGrid();
          showToast('"' + product.name + '" eliminado', 'info');
        }
      }

      document.getElementById('cancelEditBtn').addEventListener('click', resetProductForm);

      document.getElementById('saveProductBtn').addEventListener('click', () => {
        const name  = document.getElementById('pName').value.trim();
        const price = parseFloat(document.getElementById('pPrice').value);
        const icon  = document.getElementById('pIcon').value.trim();

        if (!name)                       { showToast('El nombre es requerido', 'error'); return; }
        if (isNaN(price) || price < 0)   { showToast('Ingresa un precio válido', 'error'); return; }

        if (editingId) {
          products = products.map(p => p.id === editingId ? { ...p, name, price, icon } : p);
          showToast('"' + name + '" actualizado ✏️');
        } else {
          products.push({ id: genId(), name, price, icon });
          showToast('"' + name + '" creado ✅');
        }
        saveProducts();
        renderAdminList();
        renderProductGrid();
        resetProductForm();
      });

      // Init
      renderProductGrid();
      updateDashboard();
    </script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg:       #0f172a;
        --surface:  #1e293b;
        --surface2: #243044;
        --border:   rgba(255,255,255,0.08);
        --text:     #f8fafc;
        --muted:    #94a3b8;
        --accent:   #3b82f6;
        --accent2:  #6366f1;
        --danger:   #ef4444;
        --success:  #22c55e;
        --warn:     #f59e0b;
        --radius:   14px;
        --radius-sm:8px;
        --shadow:   0 4px 24px rgba(0,0,0,0.4);
      }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        padding-bottom: 32px;
      }

      .app-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px 12px;
        max-width: 520px;
        margin: 0 auto;
      }
      .header-left { display: flex; align-items: center; gap: 12px; }
      .app-logo { font-size: 1.8rem; }
      .app-title {
        font-size: 1.25rem;
        font-weight: 800;
        background: linear-gradient(135deg, #60a5fa, #818cf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.2;
      }
      .app-subtitle { font-size: 0.72rem; color: var(--muted); font-weight: 500; margin-top: 1px; }

      main {
        max-width: 520px;
        margin: 0 auto;
        padding: 0 14px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .card {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 18px 16px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }
      .card-inner {
        background: var(--surface2);
        border-radius: var(--radius-sm);
        padding: 14px;
        border: 1px solid var(--border);
        margin-bottom: 12px;
      }

      .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
      }
      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
      }
      .section-header .section-title { margin-bottom: 0; }
      .title-icon { font-size: 1rem; }

      .badge {
        font-size: 0.68rem;
        font-weight: 600;
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
        border: 1px solid rgba(99, 102, 241, 0.3);
        padding: 3px 9px;
        border-radius: 99px;
      }

      .metric-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .metric-value.negative { color: var(--danger) !important; }
      .metric-value.positive { color: var(--success) !important; }
      .metric-value.warn     { color: var(--warn)    !important; }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 10px;
        margin-bottom: 4px;
      }

      .product-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        padding: 14px 8px 12px;
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.2s ease, background 0.2s ease;
        text-align: center;
        color: var(--text);
        -webkit-tap-highlight-color: transparent;
        position: relative;
        overflow: hidden;
      }
      .product-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(99,102,241,0.25) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .product-card:active::after { opacity: 1; }
      .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(59, 130, 246, 0.2);
        border-color: rgba(99, 102, 241, 0.4);
      }
      .product-card:active { transform: scale(0.95); }
      .product-card.selected {
        border-color: #6366f1;
        background: rgba(99,102,241,0.12);
        box-shadow: 0 0 0 2px rgba(99,102,241,0.3);
      }

      .pc-icon  { font-size: 1.8rem; line-height: 1; }
      .pc-name  { font-size: 0.72rem; font-weight: 600; color: #cbd5e1; line-height: 1.3; }
      .pc-price { font-size: 0.9rem; font-weight: 800; color: var(--accent); }

      .confirm-panel {
        background: linear-gradient(135deg, #1e3a5f 0%, #1e2d4a 100%);
        border: 1px solid rgba(99, 102, 241, 0.35);
        border-radius: var(--radius);
        padding: 16px;
        margin-top: 12px;
        animation: slideIn 0.3s ease;
