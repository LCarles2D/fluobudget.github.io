        flex: 1;
        background: rgba(255,255,255,0.08);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text);
        font-size: 0.88rem;
        padding: 10px 12px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: border-color 0.2s;
        -webkit-appearance: none;
      }
