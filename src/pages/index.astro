      .form-input--sm   { max-width: 100px; text-align: right; }
      .form-input--icon { max-width: 80px; text-align: center; font-size: 1.2rem; }
      .form-actions { display: flex; gap: 6px; align-items: center; }

      .admin-list { display: flex; flex-direction: column; gap: 6px; }
      .admin-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: var(--surface2);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        transition: background 0.15s;
      }
      .admin-item:hover { background: #2a3a52; }
      .admin-icon   { font-size: 1.3rem; flex-shrink: 0; }
      .admin-info   { flex: 1; min-width: 0; }
      .admin-name   { display: block; font-size: 0.85rem; font-weight: 600; }
      .admin-price  { display: block; font-size: 0.75rem; color: var(--muted); margin-top: 1px; }
      .admin-actions { display: flex; gap: 4px; flex-shrink: 0; }

      .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        padding: 12px 20px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        z-index: 200;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        animation: toastIn 0.25s ease;
        max-width: 320px;
        text-align: center;
        white-space: nowrap;
      }
      @keyframes toastIn {
        from { opacity: 0; transform: translateX(-50%) translateY(10px); }
        to   { opacity: 1; transform: translateX(-50%) translateY(0); }
      }
      .toast--success { background: #166534; color: #bbf7d0; border: 1px solid #22c55e; }
      .toast--error   { background: #7f1d1d; color: #fecaca; border: 1px solid #ef4444; }
      .toast--info    { background: #1e3a5f; color: #bfdbfe; border: 1px solid #3b82f6; }

      .hidden { display: none !important; }

      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #334155; border-radius: 99px; }

      @media (max-width: 380px) {
        .product-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
        .pc-icon { font-size: 1.5rem; }
      }
